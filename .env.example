# Copy to .env and fill in. ./setup.sh creates .env from this file and
# generates the secrets for you if it does not exist yet.
#
# .env is gitignored: it holds the Postgres DSN and the proxy master key.
# docker compose reads it automatically.

# --- Remote Postgres -------------------------------------------------------
# LiteLLM stores virtual keys, teams, budgets, rate-limit counters and spend
# logs here. It runs its schema migration on startup, so the user needs DDL
# rights on this database. Managed Postgres usually needs sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/litellm?sslmode=require

# --- LiteLLM secrets -------------------------------------------------------
# Admin credential for the proxy and the Admin UI. Must start with sk-.
# Treat it like a root password: use virtual keys for day-to-day clients.
LITELLM_MASTER_KEY=sk-CHANGE-ME

# Encrypts credentials at rest in Postgres. Set it ONCE -- changing it after
# models/keys exist makes the stored values unreadable.
LITELLM_SALT_KEY=CHANGE-ME

# --- Admin UI login (https://localhost:11437/ui) ---------------------------
UI_USERNAME=admin
UI_PASSWORD=CHANGE-ME

# --- Virtual key used by Open WebUI ---------------------------------------
# Create this in the Admin UI (Virtual Keys -> Create), then paste it here and
# `docker compose up -d webui`. Giving the UI its own key rather than the
# master key is what makes its traffic attributable and rate-limitable.
# Bootstrap tip: set it to the master key for the first start, create the real
# key in the UI, then swap it.
LITELLM_WEBUI_KEY=sk-CHANGE-ME

# --- OpenTelemetry ---------------------------------------------------------
# LiteLLM emits a span per request (model, deployment, latency, tokens, errors)
# to this collector. 172.31.0.1 is the pinned bridge gateway, i.e. the host --
# change it if your collector lives elsewhere.
#
# If you are NOT running a collector, comment out the `otel` entry in
# litellm/config.yaml -> litellm_settings.callbacks, or LiteLLM will log an
# export failure for every request.
OTEL_EXPORTER=otlp_http
OTEL_ENDPOINT=http://172.31.0.1:4318/v1/traces
# Comma-separated key=value pairs, if your collector needs auth.
# OTEL_HEADERS=api-key=your-key

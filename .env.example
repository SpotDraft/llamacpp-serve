# llamacpp-serve environment.
#
# Copy to `.env` (setup.sh does this for you) and uncomment what you need.
# `docker compose` reads `.env` from this directory automatically.
#
# Every value below is optional — the stack has working defaults for all of
# them. Only LLAMA_ENDPOINT_METRICS touches the base stack; everything else is
# inert unless the telemetry overlay is on.

# ===========================================================================
# llama.cpp metrics endpoint — on by default
# ===========================================================================

# llama-server's own Prometheus endpoint on :8080/metrics: KV-cache usage,
# slot occupancy, prompt vs generation token throughput. This is engine-level
# detail that eBPF cannot see, and it is useful with or without the overlay.
#
# It is never published on the host, but nginx proxies `location /`, so it is
# reachable through the TLS front door at https://localhost:11437/metrics like
# any other route. Set to false to switch it off entirely (llama.cpp only acts
# on truthy values, so `false`, `0`, `off` and `disabled` all disable it).
# Changing this recreates the llama containers.
#LLAMA_ENDPOINT_METRICS=true

# ===========================================================================
# eBPF telemetry (OpenTelemetry eBPF Instrumentation) — off by default
# ===========================================================================

# THE ON/OFF SWITCH. Uncomment to make docker-compose.otel.yml part of the
# stack; `docker compose up -d` then also starts `obi` and `collector`.
# Re-comment it (after one `docker compose down`) to go back to the base
# stack. Every other variable below is inert while this is commented.
#COMPOSE_FILE=docker-compose.yml:docker-compose.otel.yml

# --- Collector -------------------------------------------------------------

# Which pipeline the collector runs.
#   /etc/collector/local.yaml    keep everything on this host (default)
#   /etc/collector/forward.yaml  relay to an external OTLP/HTTP backend
#COLLECTOR_CONFIG_FILE=/etc/collector/local.yaml

# `basic` logs span/metric counts; `detailed` dumps full payloads into
# `docker compose logs collector`. Useful while verifying, noisy long-term.
#COLLECTOR_DEBUG_VERBOSITY=basic
#COLLECTOR_LOG_LEVEL=info

# --- Forwarding (only used by forward.yaml) --------------------------------

#OTLP_FORWARD_ENDPOINT=https://otlp.example.internal:4318
# For authenticated backends, also uncomment the `headers` block in
# otel/collector/forward.yaml.
#OTLP_FORWARD_AUTHORIZATION=Bearer <token>
#OTLP_FORWARD_INSECURE_SKIP_VERIFY=false

# --- Scraping llama.cpp's engine metrics into the collector ----------------

# Which routers to scrape, as a YAML/JSON list. Empty by default: the scrape
# job is registered but has no targets, so it never fires and logs nothing.
# Fill it in to pull llama.cpp's /metrics into the same pipeline as OBI's data.
#LLAMA_SCRAPE_TARGETS=["llama-1:8080","llama-2:8080"]

# REQUIRED once you set targets above. The routers run in router mode, where
# /metrics belongs to a model's child process, so the scrape must name a model:
# the GGUF filename without the .gguf extension, exactly as it appears in
# `GET /v1/models`. Scrapes always pass autoload=false, so a model that is not
# currently loaded reports as down rather than being pulled into VRAM by the
# scrape itself.
#
# One model per collector. For several at once, add a static_configs entry per
# model in otel/collector/*.yaml using the `__param_model` label — see the
# README section "Scraping llama.cpp's engine metrics".
#LLAMA_SCRAPE_MODEL=Qwen3-8B-Q4_K_M

#LLAMA_SCRAPE_INTERVAL=15s

# --- OBI -------------------------------------------------------------------

# Where OBI sends OTLP. Point this at your own endpoint to bypass the
# bundled collector entirely (it then just sits idle).
#OBI_OTLP_ENDPOINT=http://collector:4318
#OBI_OTLP_PROTOCOL=http/protobuf

#OBI_LOG_LEVEL=INFO

# Metric families to export. `application_service_graph` is what produces the
# nginx -> llama topology; drop it if you only want RED metrics.
#OBI_METRICS_FEATURES=application,application_span,application_service_graph

# Protocol-level instrumentations. `genai` captures LLM calls, `gpu` captures
# GPU activity. Fewer entries means fewer eBPF probes attached. Nothing in this
# stack speaks gRPC, so it is not in the default list.
#OBI_METRICS_INSTRUMENTATIONS=http,genai,gpu
#OBI_TRACES_INSTRUMENTATIONS=http,genai

# Set to `text` to print every span into `docker compose logs obi` — the
# fastest way to confirm OBI is seeing traffic. Leave `disabled` in normal use.
#OBI_TRACE_PRINTER=disabled

# Set to `true` to make OBI exit on a missing kernel capability instead of
# running with reduced functionality. Off by default so an unusual kernel
# degrades rather than crash-loops.
#OBI_ENFORCE_SYS_CAPS=false

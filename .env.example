# Copy to .env and fill in. scripts/setup-litellm-stack.sh creates .env and
# generates the secrets for you if it does not exist yet.
#
# .env is gitignored. docker compose reads it automatically.
#
# The default stack (docker compose up) uses the TLS certificate and
# llama-server sections below. Everything else applies only when you enable
# LiteLLM:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.litellm.yml
#   docker compose up -d

# --- Which stack -----------------------------------------------------------
# Uncomment to make LiteLLM the default `docker compose up` target.
# COMPOSE_FILE=docker-compose.yml:docker-compose.litellm.yml

# --- LiteLLM secrets -------------------------------------------------------
# Admin credential for the proxy and the Admin UI. Must start with sk-.
# Treat it like a root password: use virtual keys for day-to-day clients.
LITELLM_MASTER_KEY=sk-CHANGE-ME

# Encrypts credentials at rest in Postgres. Set it ONCE -- changing it after
# models/keys exist makes the stored values unreadable.
LITELLM_SALT_KEY=CHANGE-ME

# --- Bundled Postgres ------------------------------------------------------
# Password for the bundled Postgres in docker-compose.litellm.yml. LiteLLM setup
# generates one for a NEW .env; an .env written before this setting existed is
# migrated to the historical default (`litellm`) on purpose -- Postgres only
# applies POSTGRES_PASSWORD when initdb runs on an empty volume, so changing
# this against an existing postgres-data volume locks LiteLLM out.
#
# Keep it URL-safe (hex/alphanumeric): it is interpolated into DATABASE_URL.
# To rotate, see "Rotating the bundled Postgres password" in the README.
LITELLM_DB_PASSWORD=litellm

# --- Admin UI login (https://localhost:11437/ui) ---------------------------
UI_USERNAME=admin
UI_PASSWORD=CHANGE-ME

# --- Virtual key used by Open WebUI ---------------------------------------
# Create this in the Admin UI (Virtual Keys -> Create), then paste it here and
# `docker compose up -d webui`. Giving the UI its own key rather than the
# master key is what makes its traffic attributable and rate-limitable.
# Bootstrap tip: set it to the master key for the first start, create the real
# key in the UI, then swap it.
LITELLM_WEBUI_KEY=sk-CHANGE-ME

# Persist models in Postgres so the Admin UI (Models page) can add/edit them.
# The GGUF pin map is still generated from disk; do not add a second api_base
# for a model the generated routing config already pinned.
STORE_MODEL_IN_DB=True

# --- TLS certificate (SANs) -------------------------------------------------
# nginx serves a certificate signed by the local CA in nginx/certs/ca.crt.
# A client must (a) trust that CA and (b) connect by a name listed in the
# certificate's SAN list. Miss (b) and the handshake still fails -- Node
# clients report this as a generic "connection error", not a TLS error.
#
# localhost, host.docker.internal and 127.0.0.1 are ALWAYS included.
# Set CERT_HOSTNAME to the name(s) other machines use to reach this box, e.g. a
# tailnet name. Leave blank for a purely local stack.
#
# Both settings take a comma-separated list. Entries may carry an explicit
# DNS: or IP: prefix; without one, hostnames and IP literals are classified
# automatically, so a plain list of names is usually all you need:
#   CERT_HOSTNAME=dgx.example.com, dgx.internal, 100.64.0.1
#
# After changing either value, re-run scripts/setup-base-stack.sh and restart
# nginx; the certificate is reissued automatically when a listed name is
# missing. The CA is preserved, so the WebUI image does NOT need rebuilding.
# CERT_HOSTNAME=spotdraft-dgx.tailnet.spotdraftteam.com
CERT_HOSTNAME=

# Further entries, same format. Kept separate so a deployment can pin an IP
# without disturbing the hostname list.
# CERT_EXTRA_SANS=IP:100.64.0.1, DNS:dgx.internal
CERT_EXTRA_SANS=

# --- llama-server tuning ----------------------------------------------------
# Mapped onto llama-server's own LLAMA_ARG_* names in docker-compose.yml.
# The upstream names are exact and unforgiving: LLAMA_ARG_CTX_SIZE and
# LLAMA_ARG_N_PARALLEL. A near-miss like LLAMA_ARG_CONTEXT_SIZE is ignored
# without warning and you silently get llama.cpp's 4096 default instead.
# Check any new setting against `llama-server --help` before adding it.

# Context window per slot. The dominant VRAM cost after the weights.
LLAMA_CTX_SIZE=32768

# Concurrent request slots per router. Raising this multiplies KV-cache VRAM.
# If you change it, update global_max_parallel_requests in litellm/config.yaml:
# it is sized as (2 routers x 1 resident model x LLAMA_N_PARALLEL).
LLAMA_N_PARALLEL=2

# How many models stay RESIDENT per router. Extra GGUFs are still discovered
# and served, they just LRU-evict each other. Keep >= models pinned per router
# by scripts/apply-model-routing.sh, or every request pays a cold load.
LLAMA_MODELS_MAX=2

# 999 offloads every layer to GPU. Set 0 for a CPU-only box.
LLAMA_N_GPU_LAYERS=999

LLAMA_FLASH_ATTN=on

# --- OpenTelemetry ---------------------------------------------------------
# LiteLLM emits a span per request (model, deployment, latency, tokens, errors)
# to this collector. host.docker.internal is the DGX host (see extra_hosts on
# the litellm service).
#
# If you are NOT running a collector, comment out the `otel` entry in
# litellm/config.yaml -> litellm_settings.callbacks, or LiteLLM will log an
# export failure for every request.
OTEL_EXPORTER=otlp_http
OTEL_ENDPOINT=http://host.docker.internal:4318/v1/traces
# Comma-separated key=value pairs, if your collector needs auth.
# OTEL_HEADERS=api-key=your-key
